# Copy to `.env` and adjust. Loaded by pydantic-settings (case-insensitive keys).

APP_NAME=Local Vocal Assistant
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO

API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SEARCH_PROVIDER=google
CHAT_MAX_INPUT_CHARS=4000
# When no Chroma semantic memory matches, run a web search for the user message (set false to disable).
ASSISTANT_SEARCH_IF_NO_MEMORY=true

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_REQUEST_TIMEOUT=180
OLLAMA_RETRY_ATTEMPTS=3
OLLAMA_RETRY_BASE_DELAY=0.5
OLLAMA_TEMPERATURE=0.2
# 4096 = faster local inference; raise to 8192+ for heavy memory prompts (slower).
OLLAMA_NUM_CTX=4096
# Max tokens per reply (lower = faster). Use -1 for no limit (Ollama default / slower).
OLLAMA_NUM_PREDICT=320
# Startup auto-fix (handled by ./start.sh)
# AUTO_FIX_OLLAMA=1
# AUTO_START_OLLAMA=1

# Optional: root for SQLITE_PATH, CHROMA_PATH, TTS_OUTPUT_DIR, UPLOAD_DIR, TEMP_DIR when those are relative.
# In development, if the path is missing, the app may fall back to ./storage under the project.
# APP_STORAGE_PATH=/Volumes/localvocal-data/storage
SQLITE_PATH=sqlite/assistant.db
CHROMA_PATH=chroma
CHROMA_COLLECTION_NAME=conversation_memory

EMBEDDING_MODEL=nomic-embed-text
# Fewer hits = faster retrieval + shorter prompts; raise for stronger recall (slower).
MEMORY_TOP_K=12
SHORT_TERM_MESSAGE_LIMIT=14
MEMORY_KEYWORD_SUPPLEMENT=true
MEMORY_KEYWORD_MATCH_LIMIT=10
MEMORY_KEYWORD_MIN_WORD_LEN=4
MEMORY_INJECTED_CHARS_PER_MESSAGE=1400
LLM_MAX_CONTEXT_MESSAGES=12

# tiny = fastest STT (lower quality); base/small = better accuracy, slower.
WHISPER_MODEL_SIZE=base
STT_DEVICE=cpu
# false = faster interactive STT (default). true = slightly better multi-segment coherence, slower.
STT_CONDITION_ON_PREVIOUS_TEXT=false
# 1 = fastest greedy decode; 3–5 = slightly better quality, slower.
STT_BEAM_SIZE=1
# faster-whisper: int8 on CPU is fastest; use float16 with STT_DEVICE=cuda on GPU.
STT_COMPUTE_TYPE=int8
STT_TEMPERATURE=0.0
STT_VAD_FILTER=true
STT_VAD_MIN_SILENCE_MS=500
# Wall-clock cap for a single transcription (Whisper can hang on bad audio).
STT_TRANSCRIBE_TIMEOUT_SECONDS=120.0
# Voice upload normalization (WebM/MP4/etc. → WAV) before Whisper; separate from STT inference.
AUDIO_FFMPEG_TIMEOUT_SECONDS=120.0

# English VITS needs the eSpeak phonemizer on your OS (not a Python package).
# macOS: brew install espeak-ng  |  Ubuntu/Debian: sudo apt install espeak-ng
TTS_MODEL_NAME=tts_models/en/ljspeech/vits
# Playback tempo after synthesis (1.0 = normal; >1 faster). Requires ffmpeg on PATH.
TTS_PLAYBACK_SPEED=1.25
# Bangla TTS when profile language is Bangla. Use a Coqui Hub name, OR a project-relative folder
# (under the repo root) containing config.json + a .pth checkpoint — not a Hub ID (avoids download errors).
TTS_MODEL_NAME_BN=tts_models/bn/custom/vits-male
TTS_OUTPUT_DIR=audio
# false = synthesized WAVs use TEMP_DIR only (no long-term storage/audio). true = keep files under TTS_OUTPUT_DIR.
PERSIST_TTS_FILES=false
# false = voice recordings + ffmpeg temp use TEMP_DIR only (no storage/uploads accumulation).
PERSIST_VOICE_UPLOADS=false
TTS_MAX_CHARS=6000
TTS_TIMEOUT_SECONDS=180.0
TTS_MIN_OUTPUT_BYTES=256
# Delete each WAV after the client can fetch/play it (text stays in DB). Set false to keep files.
TTS_EPHEMERAL=true
TTS_EPHEMERAL_GRACE_SECONDS=120
# Safety net: remove any leftover WAVs older than this (hours).
TTS_RETENTION_HOURS=6
# Download Coqui weights after startup; warm Whisper + Coqui in RAM (faster first voice; more memory).
TTS_PRELOAD_ON_STARTUP=true
WARM_SPEECH_MODELS_ON_STARTUP=true
# false = faster/lighter startup (no second Coqui init); first Bangla reply loads that checkpoint on demand.
WARM_BANGLA_TTS_ON_STARTUP=true

DUCKDUCKGO_REGION=wt-wt
DUCKDUCKGO_SAFESEARCH=moderate
DUCKDUCKGO_TIME_LIMIT=m
DUCKDUCKGO_MAX_RESULTS=3
DUCKDUCKGO_REQUEST_TIMEOUT=5.0
DUCKDUCKGO_RETRY_ATTEMPTS=2

UPLOAD_DIR=uploads
TEMP_DIR=tmp
# Rarely needed; defaults to project root. Uncomment to override static file root.
# FILES_ROOT=
